{
  "productName": "Restricted IDE",
  "version": "0.1.0",
  "identifier": "com.restrictedide.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Restricted IDE",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: blob:; font-src 'self' data: https:; connect-src 'self' http://localhost:* http://127.0.0.1:* http://*:* https://*:*; frame-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../scripts/windows/enable-exam-shell.ps1",
      "../scripts/windows/disable-exam-shell.ps1",
      "../scripts/windows/EXAM_SHELL.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
